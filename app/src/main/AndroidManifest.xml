<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="com.bernilla.denunciasapp">

    <!-- Permiso obligatorio para llamadas a la API REST por Red/Internet -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Bernilla_Minguillo_EC"
        android:usesCleartextTraffic="true">

        <!-- Actividad Principal: Lista Paginada -->
        <activity
            android:name="com.bernilla.denunciasapp.ui.activity.MainActivity"
            android:exported="true"
            android:label="@string/title_main"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Actividad para Registrar Nueva Denuncia -->
        <activity
            android:name="com.bernilla.denunciasapp.ui.activity.RegistrarActivity"
            android:exported="false"
            android:label="@string/title_registrar"
            android:windowSoftInputMode="adjustResize" />

        <!-- Actividad para Ver Detalle y Atender Denuncia -->
        <activity
            android:name="com.bernilla.denunciasapp.ui.activity.DetalleActivity"
            android:exported="false"
            android:label="@string/title_detalle" />

        <!-- Actividad para Buscar Denuncias por DNI de Ciudadano -->
        <activity
            android:name="com.bernilla.denunciasapp.ui.activity.BuscarActivity"
            android:exported="false"
            android:label="@string/title_buscar"
            android:windowSoftInputMode="adjustResize" />

    </application>

    <uses-permission android:name="android.permission.INTERNET" />

</manifest>